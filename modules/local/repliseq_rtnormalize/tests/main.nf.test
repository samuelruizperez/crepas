nextflow_process {

    name "Test Process REPLISEQ_RTNORMALIZE"
    script "../main.nf"
    process "REPLISEQ_RTNORMALIZE"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "repliseq_rtnormalize"
    tag "deeptools/multibamsummary"

    setup {

        // Two phases x two biological replicates, built from four real, same-genome public test
        // BAMs (chr21). Only two distinct read sets exist here -- `markduplicates` and
        // `recalibrated` are the same reads of the same sample -- so `test` supplies both early
        // replicates and `test2` both late ones. That is what makes the early/late ratio carry
        // real signal; the cost is that every early/late replicate pair is equally correlated,
        // so `auto` always resolves to `pooled` and `paired` is covered by its own test below.
        run("DEEPTOOLS_MULTIBAMSUMMARY") {
            script "../../../nf-core/deeptools/multibamsummary/main.nf"
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    [
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test.paired_end.markduplicates.sorted.bam', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test.paired_end.recalibrated.sorted.bam', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test2.paired_end.markduplicates.sorted.bam', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test2.paired_end.recalibrated.sorted.bam', checkIfExists: true)
                    ],
                    [
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test.paired_end.markduplicates.sorted.bam.bai', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test.paired_end.recalibrated.sorted.bam.bai', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test2.paired_end.markduplicates.sorted.bam.bai', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test2.paired_end.recalibrated.sorted.bam.bai', checkIfExists: true)
                    ],
                    [ 'early_1', 'early_2', 'late_1', 'late_2' ]
                ]
                input[1] = [ [:], [] ]
                """
            }
        }

    }

    test("homo_sapiens - 4 replicates - pipeline defaults (pooled, quantile-normalized, per-replicate loess)") {

        when {
            process {
                """
                input[0] = DEEPTOOLS_MULTIBAMSUMMARY.out.raw_counts.map { meta, counts ->
                    [ meta, counts, [ 'early', 'early', 'late', 'late' ], [ '1', '2', '1', '2' ] ]
                }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("homo_sapiens - 4 replicates - CPM only, loess smoothed on the ratio") {

        config "./nextflow_cpm_loess.config"

        when {
            process {
                """
                input[0] = DEEPTOOLS_MULTIBAMSUMMARY.out.raw_counts.map { meta, counts ->
                    [ meta, counts, [ 'early', 'early', 'late', 'late' ], [ '1', '2', '1', '2' ] ]
                }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("homo_sapiens - 4 replicates - pooled, quantile-normalized, rolling-mean smoothed") {

        config "./nextflow_pooled_qn_roll.config"

        when {
            process {
                """
                input[0] = DEEPTOOLS_MULTIBAMSUMMARY.out.raw_counts.map { meta, counts ->
                    [ meta, counts, [ 'early', 'early', 'late', 'late' ], [ '1', '2', '1', '2' ] ]
                }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("homo_sapiens - 4 replicates - paired replicate combination") {

        config "./nextflow_paired.config"

        when {
            process {
                """
                input[0] = DEEPTOOLS_MULTIBAMSUMMARY.out.raw_counts.map { meta, counts ->
                    [ meta, counts, [ 'early', 'early', 'late', 'late' ], [ '1', '2', '1', '2' ] ]
                }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("homo_sapiens - 3 fractions - replication-timing index") {

        // Same four count columns, reinterpreted as three fractions, so that the index path runs
        // over real data. The index needs at least three fractions; with only early and late it
        // is not emitted.
        when {
            process {
                """
                input[0] = DEEPTOOLS_MULTIBAMSUMMARY.out.raw_counts.map { meta, counts ->
                    [ meta, counts, [ 'early', 'early', 'mid', 'late' ], [ '1', '2', '1', '1' ] ]
                }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.index_raw },
                { assert process.out.index_smooth },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("homo_sapiens - 4 replicates - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = DEEPTOOLS_MULTIBAMSUMMARY.out.raw_counts.map { meta, counts ->
                    [ meta, counts, [ 'early', 'early', 'late', 'late' ], [ '1', '2', '1', '2' ] ]
                }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
