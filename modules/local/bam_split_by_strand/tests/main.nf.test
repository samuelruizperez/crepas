nextflow_process {

    name "Test Process BAM_SPLIT_BY_STRAND"
    script "../main.nf"
    process "BAM_SPLIT_BY_STRAND"

    tag "modules"
    tag "modules_local"
    tag "bam_split_by_strand"

    test("sarscov2 - bam - forward strandedness") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false, strandedness:'forward' ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.f_bam,
                    process.out.r_bam,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                    ).match() }
            )
        }

    }

    test("sarscov2 - bam - reverse strandedness") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false, strandedness:'reverse' ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.f_bam,
                    process.out.r_bam,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                    ).match() }
            )
        }

    }

    test("sarscov2 - bam - forward strandedness - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false, strandedness:'forward' ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
