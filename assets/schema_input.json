{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/grothlab/glseq/main/assets/schema_input.json",
    "title": "grothlab/glseq pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "sample": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "The sample identifier cannot contain spaces. It must be the same for all biological and technical replicates of the same sample.",
                "meta": ["id"]
            },
            "biological_replicate": {
                "type": ["string", "integer"],
                "pattern": "^\\S+$",
                "errorMessage": "The biological replicate must be provided and cannot contain spaces. If you do not have biological replicates you can set the replicate value to the same number or string for all of your samples.",
                "meta": ["brep"]
            },
            "technical_replicate": {
                "type": ["string", "integer"],
                "pattern": "^\\S+$",
                "errorMessage": "Technical replicate cannot contain spaces.",
                "meta": ["trep"]
            },
            "input_control": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "The input control column cannot contain spaces",
                "meta": ["input_control"]
            },
            "input_control_biological_replicate": {
                "type": ["string", "integer"],
                "pattern": "^\\S+$",
                "errorMessage": "Input control biological replicate",
                "meta": ["input_brep"]
            },
            "input_control_technical_replicate": {
                "type": ["string", "integer"],
                "pattern": "^\\S+$",
                "errorMessage": "Input control technical replicate",
                "meta": ["input_trep"]
            },
            "exp_type": {
                "type": "string",
                "enum": ["ChIP-seq", "ChOR-seq", "SCAR-seq", "ChIP-exo", "ATAC-seq", "OK-seq"],
                "errorMessage": "Sequencing experiment type must be provided and be one of 'ChIP-seq', 'ChOR-seq', 'SCAR-seq', 'ChIP-exo', 'ATAC-seq' or 'OK-seq'",
                "meta": ["exp_type"]
            },            
            "strandedness": {
                "type": "string",
                "enum": ["forward", "reverse"],
                "errorMessage": "Strandedness must be 'forward' or 'reverse'",
                "meta": ["strandedness"]
            },
            "antibody": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Antibody entry cannot contain spaces",
                "meta": ["antibody"]
            },
            "okseq_part_file": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.(txt|tsv)\\.gz$",
                "errorMessage": "GZIP-compressed FastQ file for OK-seq RFD/partition file must be provided, cannot contain spaces and must have extension '.txt.gz' or '.tsv.gz'",
                "meta": ["okseq_part_file"]
            },
            "fastq_1": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.f(ast)?q\\.gz$",
                "errorMessage": "GZIP-compressed FastQ file for reads 1 must be provided, cannot contain spaces and must have extension '.fq.gz' or '.fastq.gz'"
            },
            "fastq_2": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.f(ast)?q\\.gz$",
                "errorMessage": "GZIP-compressed FastQ file for reads 2 cannot contain spaces and must have extension '.fq.gz' or '.fastq.gz'"
            },
            "fastq_umi": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.f(ast)?q\\.gz$",
                "errorMessage": "GZIP-compressed FastQ file for UMI reads cannot contain spaces and must have extension '.fq.gz' or '.fastq.gz'"
            }
        },
        "required": ["sample", "fastq_1", "exp_type", "biological_replicate"],
        "dependentRequired": {
            "input_control": ["input_control_biological_replicate"],
            "input_control_biological_replicate": ["input_control"],
            "input_control_technical_replicate": ["input_control_biological_replicate", "technical_replicate"]

        }
    }
}
