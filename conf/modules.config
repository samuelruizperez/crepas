/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

//
// General configuration options
//

process {
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'SAMPLESHEET_CHECK' {
        ext.args   = 'samplesheet.valid.csv'
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'KHMER_UNIQUEKMERS' {
        publishDir = [ enabled: false ]
    }
}

//
// Genome preparation options
//

process {
    withName: 'GUNZIP_.*' {
        publishDir = [
            path: { "${params.outdir}/genome" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            enabled: params.save_reference
        ]
    }

    withName: 'UNTAR_.*' {
        ext.args2 = '--no-same-owner'
        publishDir = [
            path: { "${params.outdir}/genome/index" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            enabled: params.save_reference
        ]
    }

    withName: 'BWA_INDEX|BOWTIE2_BUILD|STAR_GENOMEGENERATE' {
        publishDir = [
            path: { "${params.outdir}/genome/index" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            enabled: params.save_reference
        ]
    }

    withName: 'GFFREAD' {
        ext.args   = '--keep-exon-attrs -F -T'
        publishDir = [
            path: { "${params.outdir}/genome" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            enabled: params.save_reference
        ]
    }

    withName: 'GTF2BED' {
        publishDir = [
            path: { "${params.outdir}/genome" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            enabled: params.save_reference
        ]
    }

    withName: 'CUSTOM_GETCHROMSIZES' {
        publishDir = [
            path: { "${params.outdir}/genome" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            enabled: params.save_reference
        ]
    }

    withName: 'EDITCHROMSIZES_ENDO' {
        publishDir = [
            path: { "${params.outdir}/genome" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            enabled: params.save_reference
        ]
    }

    withName: 'GENOME_BLACKLIST_REGIONS' {
        publishDir = [
            path: { "${params.outdir}/genome" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            enabled: params.save_reference
        ]
    }
}

//
// Read QC and trimming options
//

if (!(params.skip_fastqc || params.skip_qc)) {
    process {
        withName: '.*:FASTQ_FASTQC_UMITOOLS_UMITRANSFER_TRIMGALORE:FASTQC' {
            ext.args = '--quiet'
            publishDir = [
                [
                    path: { "${params.outdir}/fastqc" },
                    mode: params.publish_dir_mode,
                    pattern: "*.{html}"
                ],
                [
                    path: { "${params.outdir}/fastqc/zips" },
                    mode: params.publish_dir_mode,
                    pattern: "*.{zip}"
                ]
            ]
        }
    }
}


if (params.with_umi) {
    process {
        withName: '.*:FASTQ_FASTQC_UMITOOLS_UMITRANSFER_TRIMGALORE:UMITRANSFER' {
            ext.args   = "--delim '_' --correct_numbers"
            publishDir = [
                [
                    path: { "${params.outdir}/umitransfer" },
                    mode: params.publish_dir_mode,
                    pattern: "*.{fastq.gz,log}"
                ]
            ]
        }

        withName: '.*:FASTQ_FASTQC_UMITOOLS_UMITRANSFER_TRIMGALORE:UMITOOLS_EXTRACT' {
            publishDir = [
                [
                    path: { "${params.outdir}/umitools_extract" },
                    mode: params.publish_dir_mode,
                    pattern: "*.{fastq.gz,log}"
                ]
            ]
        }
    }
}

if (!params.skip_trimming) {
    process {
        withName: 'TRIMGALORE' {
        // For this module,the prefix is not for the output file but for the input
        // Besides, Trimgalore automatically adds a suffix to the trimmed file (e.g. "sample_1.50bp_5prime.fq.gz")
        // ext.prefix = { 
        //     "${meta.id}" +
        //     "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
        //     "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}"
        // }
        ext.args   = {
                [
                    '--fastqc',
                    params.trim_nextseq > 0 ? "--nextseq ${params.trim_nextseq}" : '',
                    params.clip_r1 > 0 ? "--clip_r1 ${params.clip_r1}" : '',
                    params.clip_r2 > 0 ? "--clip_r2 ${params.clip_r2}" : '',
                    params.three_prime_clip_r1 > 0 ? "--three_prime_clip_r1 ${params.three_prime_clip_r1}" : '',
                    params.three_prime_clip_r2 > 0 ? "--three_prime_clip_r2 ${params.three_prime_clip_r2}" : '',
                    params.trim_minimum_length > 0 ? "--length ${params.trim_minimum_length}" : ''
                ].join(' ').trim()
            }
            publishDir = [
                [
                    path: { "${params.outdir}/trimgalore/fastqc" },
                    mode: params.publish_dir_mode,
                    pattern: "*.html"
                ],
                [
                    path: { "${params.outdir}/trimgalore/fastqc/zips" },
                    mode: params.publish_dir_mode,
                    pattern: "*.zip"
                ],
                [
                    path: { "${params.outdir}/trimgalore/logs" },
                    mode: params.publish_dir_mode,
                    pattern: "*.txt"
                ],
                [
                    path: { "${params.outdir}/trimgalore" },
                    mode: params.publish_dir_mode,
                    pattern: "*.fq.gz",
                    enabled: params.save_trimmed

                ]
            ]
        }
    }

    if (params.hardtrim3_length || params.hardtrim5_length) {
        process {
            withName: 'TRIMGALORE_HARDTRIM' {
                ext.args  = {
                    [
                        '--fastqc',
                        params.hardtrim5_length ? "--hardtrim5 ${params.hardtrim5_length}" : '',
                        params.hardtrim3_length ? "--hardtrim3 ${params.hardtrim3_length}" : ''
                    ].join(' ').trim()
                }
                publishDir = [
                    path: { "${params.outdir}/trimgalore/hardtrim" },
                    mode: params.publish_dir_mode,
                    pattern: "*.fq.gz",
                    enabled: params.save_htrimmed
                ]
            }
        }
    }
}

process {
    withName: '.*:FASTQ_ALIGN_.*:BAM_SORT_STATS_SAMTOOLS:SAMTOOLS_SORT' {
        ext.prefix = { 
            "${meta.id}" +
            "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
            "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}" +
            "${params.allocate_n_multimappers && params.allocation_method == 'chromap' ? '.cm_allo' : ''}" +
            ".Lb.sorted"
        }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/library" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            enabled: params.save_align_intermeds
        ]
    }

    withName: '.*:FASTQ_ALIGN_.*:BAM_SORT_STATS_SAMTOOLS:SAMTOOLS_INDEX' {
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/library" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            enabled: params.save_align_intermeds
        ]
    }

    withName: '.*:FASTQ_ALIGN_.*:BAM_SORT_STATS_SAMTOOLS:BAM_STATS_SAMTOOLS:SAMTOOLS_.*' {
         ext.prefix = { 
            "${meta.id}" +
            "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
            "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}" +
            "${params.allocate_n_multimappers && params.allocation_method == 'chromap' ? '.cm_allo' : ''}" +
            ".Lb.sorted.bam"
        }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/library" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            enabled: params.save_align_intermeds
        ]
    }
}

if (params.aligner == 'bwa') {
    process {
        withName: 'BWA_MEM' {
            ext.args   = {
                [
                    '-M',
                    params.bwa_min_score ? " -T ${params.bwa_min_score}" : '',
                    meta.read_group ? "-R ${meta.read_group}": ''
                ].join(' ').trim()
            }
            ext.args2  = '-bhS -F 0x0100 -O BAM'
            ext.prefix = { 
                "${meta.id}" +
                "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
                "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}" +
                ".Lb"
            }
            publishDir = [
                path: { "${params.outdir}/${params.aligner}/library" },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
                enabled: false
            ]
        }
    }
}

if (params.aligner == 'bowtie2') {
    process {
        withName: 'BOWTIE2_ALIGN' {
            ext.prefix = { 
                "${meta.id}" +
                "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
                "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}" +
                ".Lb" 
            }
            ext.args   = {
                [
                    meta.read_group ? "--rg-id ${meta.id} --rg SM:${meta.id - ~/_T\d+$/} --rg PL:ILLUMINA --rg LB:${meta.id} --rg PU:1" : '',
                    params.seq_center ? "--rg CN:${params.seq_center}" : '',
                    params.map_n_multimappers ? "-k ${params.map_n_multimappers}" : '',
                    "-X2000"
                ].join(' ').trim()
            }
            publishDir = [
                [
                    path: { "${params.outdir}/${params.aligner}/library" },
                    mode: params.publish_dir_mode,
                    saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
                    enabled: false
                ],
                [
                    path: { "${params.outdir}/${params.aligner}/library/unmapped" },
                    mode: params.publish_dir_mode,
                    pattern: '*.fastq.gz',
                    enabled: params.save_unaligned
                ]
            ]
        }
    }
}

if (params.aligner == 'chromap') {
    process {
        withName: 'CHROMAP_INDEX' {
            publishDir = [
                path: { "${params.outdir}/genome/index/${params.aligner}" },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }

        withName: 'CHROMAP_CHROMAP' {
            ext.args   = {
                [
                    "-l 2000",
                    "--SAM",
                    // This is done later in the alignmentsieve step:
                    //meta.exp_type == 'atacseq' ? "--Tn5-shift" : '',
                    params.map_n_multimappers ? "--max-num-best-mappings ${params.map_n_multimappers} --drop-repetitive-reads ${params.map_n_multimappers} -q 0" : '',  
                    params.allocation_method == 'chromap' ? "--allocate-multi-mappings": "--low-mem"
                ].join(' ').trim()
            }
            ext.args3  = { meta.read_group ? "-r ${meta.read_group}" : '' }
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}${params.allocate_n_multimappers && params.allocation_method == 'chromap' ? '.cm_allo' : ''}.Lb" }
            publishDir = [
                path: { "${params.outdir}/${params.aligner}/library" },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
                enabled: false
            ]
        }
    }
}

if (params.aligner == 'star') {
    process {
        withName: 'STAR_ALIGN' {
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.Lb" }
            ext.args   = [
                '--runMode alignReads',
                '--alignIntronMax 1',
                '--alignEndsType EndToEnd',
                '--outSAMtype BAM Unsorted',
                '--readFilesCommand zcat',
                '--runRNGseed 0',
                '--outSAMattributes NH HI AS NM MD',
                params.save_unaligned ? '--outReadsUnmapped Fastx' : ''
            ].join(' ').trim()
            publishDir = [
                [
                    path: { "${params.outdir}/${params.aligner}/library/log" },
                    mode: params.publish_dir_mode,
                    pattern: '*.{out,tab}'
                ],
                [
                    path: { "${params.outdir}/${params.aligner}/library" },
                    mode: params.publish_dir_mode,
                    pattern: '*.bam',
                    enabled: false
                ],
                [
                    path: { "${params.outdir}/${params.aligner}/library/unmapped" },
                    mode: params.publish_dir_mode,
                    pattern: '*.fastq.gz',
                    enabled: params.save_unaligned
                ]
            ]
        }
    }
}

if (params.aligner == 'hisat2') {
    process {
        withName: 'HISAT2_ALIGN' {
            ext.args   = {
                [   '--no-spliced-alignment',
                    '--new-summary',
                    meta.read_group ? "--rg-id ${meta.id} --rg SM:${meta.id - ~/_T\d+$/} --rg PL:ILLUMINA --rg LB:${meta.id} --rg PU:1" : '',
                    params.seq_center ? "--rg CN:${params.seq_center}" : '',
                    params.allocate_n_multimappers ? "-k ${params.allocate_n_multimappers}" : '--very-sensitive',
                    "-X2000"
                ].join(' ').trim()
            }
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.Lb" }
            publishDir = [
                [
                    path: { "${params.outdir}/${params.aligner}/library/log" },
                    mode: params.publish_dir_mode,
                    pattern: '*.log'
                ],
                [
                    path: { "${params.outdir}/${params.aligner}/library" },
                    mode: params.publish_dir_mode,
                    saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
                    enabled: false
                ],
                [
                    path: { "${params.outdir}/${params.aligner}/library/unmapped" },
                    mode: params.publish_dir_mode,
                    pattern: '*.fastq.gz',
                    enabled: params.save_unaligned
                ]
            ]
        }
    }
}

process {
    withName: 'PICARD_MERGESAMFILES' {
        ext.args   = '--SORT_ORDER coordinate --VALIDATION_STRINGENCY LENIENT --TMP_DIR tmp'
        ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}${params.allocate_n_multimappers && params.allocation_method == 'chromap' ? '.cm_allo' : ''}.mLb.sorted" }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/mergedLibrary" },
            mode: params.publish_dir_mode,
            pattern: '*.bam',
            enabled: params.save_align_intermeds
        ]
    }

    withName: 'GROTHLAB_GLSEQ:GLSEQ:SAMTOOLS_INDEX' {
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/mergedLibrary" },
            mode: params.publish_dir_mode,
            pattern: '*.{bai,csi,crai}',
            enabled: params.save_align_intermeds
        ]
    }

    withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_STATS_SAMTOOLS:SAMTOOLS_.*' {
        ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}${params.allocate_n_multimappers && params.allocation_method == 'chromap' ? '.cm_allo' : ''}.mLb.sorted" }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/mergedLibrary" },
            mode: params.publish_dir_mode,
            pattern: '*.{stats,flagstat,idxstats}',
            enabled: params.save_align_intermeds
        ]
    }
}

if (!params.skip_preseq) {
    process {
        withName: '.*:PRESEQ_LCEXTRAP' {
            ext.args   = '-verbose -bam -seed 1 -seg_len 100000000'
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}${params.allocate_n_multimappers && params.allocation_method == 'chromap' ? '.cm_allo' : ''}.mLb" }
            publishDir = [
                path: { "${params.outdir}/${params.aligner}/mergedLibrary/preseq" },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }
    }
}

if (params.with_umi) {
    process {
        withName: '.*:BAM_DEDUP_STATS_SAMTOOLS_UMITOOLS:UMITOOLS_DEDUP' {
            ext.args = '--method=percentile --paired --unpaired-reads=discard --chimeric-pairs=discard'
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}${params.allocate_n_multimappers && params.allocation_method == 'chromap' ? '.cm_allo' : ''}.mLb.dedup.sorted" }
            publishDir = [
                path: { "${params.outdir}/${params.aligner}/mergedLibrary/umi_dedup" },
                mode: params.publish_dir_mode,
                pattern: '*.{bam,bai,log}',
                enabled: params.save_align_intermeds
            ]
        }

        withName: '.*:BAM_DEDUP_STATS_SAMTOOLS_UMITOOLS:SAMTOOLS_INDEX' {
            publishDir = [
                path: { "${params.outdir}/${params.aligner}/mergedLibrary/umi_dedup" },
                mode: params.publish_dir_mode,
                pattern: '*.{bai,csi,crai}',
                enabled: params.save_align_intermeds
            ]
        }

        withName: '.*:BAM_DEDUP_STATS_SAMTOOLS_UMITOOLS:BAM_STATS_SAMTOOLS:SAMTOOLS_.*' {
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}${params.allocate_n_multimappers && params.allocation_method == 'chromap' ? '.cm_allo' : ''}.mLb.dedup.sorted" }
            publishDir = [
                path: { "${params.outdir}/${params.aligner}/mergedLibrary/umi_dedup" },
                mode: params.publish_dir_mode,
                pattern: '*.{stats,flagstat,idxstats}',
                enabled: params.save_align_intermeds
            ]
        }
    }
}

if (!params.with_umi) {
    process {
        withName: '.*:BAM_MARKDUPLICATES_PICARD:PICARD_MARKDUPLICATES' {
            ext.args   = '--ASSUME_SORTED true --REMOVE_DUPLICATES false --VALIDATION_STRINGENCY LENIENT --TMP_DIR tmp'
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}${params.allocate_n_multimappers && params.allocation_method == 'chromap' ? '.cm_allo' : ''}.mLb.mkD.sorted" }
            publishDir = [
                [
                    path: { "${params.outdir}/${params.aligner}/mergedLibrary/picard_markduplicates" },
                    mode: params.publish_dir_mode,
                    pattern: '*.metrics.txt'
                ],
                [
                    path: { "${params.outdir}/${params.aligner}/mergedLibrary/picard_markduplicates" },
                    mode: params.publish_dir_mode,
                    pattern: '*.bam',
                    enabled: params.save_align_intermeds
                ]
            ]
        }

        withName: '.*:BAM_MARKDUPLICATES_PICARD:SAMTOOLS_INDEX' {
            publishDir = [
                path: { "${params.outdir}/${params.aligner}/mergedLibrary/picard_markduplicates" },
                mode: params.publish_dir_mode,
                pattern: '*.{bai,csi,crai}',
                enabled: params.save_align_intermeds
            ]
        }

        withName: '.*:BAM_MARKDUPLICATES_PICARD:BAM_STATS_SAMTOOLS:SAMTOOLS_.*' {
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}${params.allocate_n_multimappers && params.allocation_method == 'chromap' ? '.cm_allo' : ''}.mLb.mkD.sorted" }
            publishDir = [
                path: { "${params.outdir}/${params.aligner}/mergedLibrary/picard_markduplicates" },
                mode: params.publish_dir_mode,
                pattern: '*.{stats,flagstat,idxstats}'
            ]
        }
    }
}

process {
    withName: '.*:BAM_FILTER_SAMBAMBA:SAMBAMBA_VIEW' {
        ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}${params.allocate_n_multimappers && params.allocation_method == 'chromap' ? '.cm_allo' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1" }
        ext.args = {
            [
                meta.single_end ?
                    (params.with_umi ? "" : "-F 'not duplicate'") :
                        (params.with_umi ? "-F 'paired and proper_pair and not (unmapped or mate_is_unmapped)'" :
                            "-F 'not duplicate and paired and proper_pair and not (unmapped or mate_is_unmapped)'"),
                "--format bam"
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/mergedLibrary/bam_filter" },
            mode: params.publish_dir_mode,
            pattern: '*.bam',
            saveAs: { (meta.single_end || params.save_align_intermeds) ? "${it}" : null }
        ]
    }

    withName: '.*:BAM_FILTER_SAMBAMBA:BAM_SORT_STATS_SAMTOOLS:SAMTOOLS_SORT' {
        ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}${params.allocate_n_multimappers && params.allocation_method == 'chromap' ? '.cm_allo' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1.sorted" }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/mergedLibrary/bam_filter" },
            mode: params.publish_dir_mode,
            pattern: '*.bam'
        ]
    }

    withName: '.*:BAM_FILTER_SAMBAMBA:BAM_SORT_STATS_SAMTOOLS:SAMTOOLS_INDEX' {
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/mergedLibrary/bam_filter" },
            mode: params.publish_dir_mode,
            pattern: '*.{bai,csi,crai}'
        ]
    }

    withName: '.*:BAM_FILTER_SAMBAMBA:BAM_SORT_STATS_SAMTOOLS:BAM_STATS_SAMTOOLS:.*' {
        ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}${params.allocate_n_multimappers && params.allocation_method == 'chromap' ? '.cm_allo' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1.sorted" }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/mergedLibrary/bam_filter" },
            mode: params.publish_dir_mode,
            pattern: "*.{stats,flagstat,idxstats}"
        ]
    }
}

if (params.spikein_genome) {
    process {
        withName: '.*:BAM_SPIKEIN_SPLIT:BAM_SPLIT_BY_GENOME_ENDO' {
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}${params.allocate_n_multimappers && params.allocation_method == 'chromap' ? '.cm_allo' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1" }
            publishDir = [
                path: { "${params.outdir}/${params.aligner}/mergedLibrary/spikein_split" },
                mode: params.publish_dir_mode,
                pattern: '*.bam',
                enabled: params.save_spikein_intermeds

            ]
        }

        withName: '.*:BAM_SPIKEIN_SPLIT:BAM_SPLIT_BY_GENOME_EXO' {
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}${params.allocate_n_multimappers && params.allocation_method == 'chromap' ? '.cm_allo' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1" }
            publishDir = [
                path : { "${params.outdir}/${params.aligner}/mergedLibrary/spikein_split" },
                mode : params.publish_dir_mode,
                pattern : '*.bam',
                enabled: params.save_spikein_intermeds
            ]
        }

        withName: '.*:BAM_SPIKEIN_SPLIT:SAMTOOLS_INDEX' {
            publishDir = [
                path : { "${params.outdir}/${params.aligner}/mergedLibrary/spikein_split" },
                mode: params.publish_dir_mode,
                pattern: '*.{bai,csi,crai}',
                enabled: params.save_spikein_intermeds
            ]
        }

        withName: '.*:BAM_SPIKEIN_SPLIT:SAMBAMBA_VIEW' {
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}${params.allocate_n_multimappers && params.allocation_method == 'chromap' ? '.cm_allo' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1.${meta.genome}.flT2" }
            ext.args = {
                [
                meta.single_end ?
                    (params.with_umi ? "" : "-F 'not duplicate'") :
                        (params.with_umi ? "-F 'paired and proper_pair and not (unmapped or mate_is_unmapped)'" :
                            "-F 'not duplicate and paired and proper_pair and not (unmapped or mate_is_unmapped)'"),
                "--format bam"
            ].join(' ').trim()
            }
            publishDir = [
                path : { "${params.outdir}/${params.aligner}/mergedLibrary/spikein_split" },
                mode : params.publish_dir_mode,
                pattern : '*.bam',
                enabled: params.save_spikein_intermeds
            ]
        }

        withName: '.*:BAM_SPIKEIN_SPLIT:BAM_SORT_STATS_SAMTOOLS:SAMTOOLS_SORT' {
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}${params.allocate_n_multimappers && params.allocation_method == 'chromap' ? '.cm_allo' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1.${meta.genome}.flT2.sorted" }
            publishDir = [
                path : { "${params.outdir}/${params.aligner}/mergedLibrary/spikein_split" },
                mode: params.publish_dir_mode,
                pattern: '*.bam'
            ]
        }

        withName: '.*:BAM_SPIKEIN_SPLIT:BAM_SORT_STATS_SAMTOOLS:SAMTOOLS_INDEX' {
            publishDir = [
                path : { "${params.outdir}/${params.aligner}/mergedLibrary/spikein_split" },
                mode: params.publish_dir_mode,
                pattern: '*.{bai,csi,crai}'
            ]
        }

        withName: '.*:BAM_SPIKEIN_SPLIT:BAM_SORT_STATS_SAMTOOLS:BAM_STATS_SAMTOOLS:.*' {
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}${params.allocate_n_multimappers && params.allocation_method == 'chromap' ? '.cm_allo' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1.${meta.genome}.flT2.sorted" }
            publishDir = [
                path : { "${params.outdir}/${params.aligner}/mergedLibrary/spikein_split" },
                mode: params.publish_dir_mode,
                pattern: "*.{stats,flagstat,idxstats}"
            ]
        }
    }
}

if (params.allocate_n_multimappers && params.allocation_method != 'chromap') {

    process {
        withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_ALLOCATE_MULTIMAPPERS:SAMTOOLS_SORT' {
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}.nsorted" }
            ext.args   = '-n'
            publishDir = [
                path: { "${params.outdir}/${params.aligner}/mergedLibrary/bam_nsorted/" },
                mode: params.publish_dir_mode,
                pattern: '*.bam',
                enabled: params.save_allocation_intermeds
            ]
        }

        if (params.allocation_method == 'allo') {
            withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_ALLOCATE_MULTIMAPPERS:ALLO' {
                ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}.allo" }
                //--ignore is used here to skip check for samtools collate in the bam header; samtools sort is used instead, but not detected
                ext.args =  { 
                    [
                        "--ignore",
                        params.allo_mixed_cnn ? '--mixed' : ''
                    ].join(' ').trim()
                }
                publishDir = [
                    [
                        path: { "${params.outdir}/${params.aligner}/mergedLibrary/${params.allocation_method}/" },
                        mode: params.publish_dir_mode,
                        pattern: "*.bam",
                        enabled: params.save_allocation_intermeds
                    ],
                    [
                        path: { "${params.outdir}/${params.aligner}/mergedLibrary/${params.allocation_method}/" },
                        mode: params.publish_dir_mode,
                        pattern: "*.log"    
                    ]
                ]
            }
        }

        if (params.allocation_method == 'mmr') {
            withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_ALLOCATE_MULTIMAPPERS:MMR' {
                ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}.mmr" }
                ext.args   = {
                [
                    "--best-only",
                    "--filter-dist 0",
                    "--init-secondary"
                ].join(' ').trim()
            }
                publishDir = [
                    path: { "${params.outdir}/${params.aligner}/mergedLibrary/${params.allocation_method}/" },
                    mode: params.publish_dir_mode,
                    pattern: "*.bam",
                    enabled: params.save_allocation_intermeds
                ]
            }
        }

        withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_ALLOCATE_MULTIMAPPERS:BAM_SORT_STATS_SAMTOOLS:SAMTOOLS_SORT' {
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2.' : ''}${params.allocation_method}.sorted" }
            publishDir = [
                path: { "${params.outdir}/${params.aligner}/mergedLibrary/${params.allocation_method}/" },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
                enabled: params.save_allocation_intermeds,
                pattern: '*.bam'

            ]
        }

        withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_ALLOCATE_MULTIMAPPERS:BAM_SORT_STATS_SAMTOOLS:SAMTOOLS_INDEX' {
            publishDir = [
                path: { "${params.outdir}/${params.aligner}/mergedLibrary/${params.allocation_method}/" },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
                enabled: params.save_allocation_intermeds
            ]
        }

        withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_ALLOCATE_MULTIMAPPERS:BAM_SORT_STATS_SAMTOOLS:BAM_STATS_SAMTOOLS:SAMTOOLS_.*' {
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2.' : ''}${params.allocation_method}.sorted" }
            publishDir = [
                path: { "${params.outdir}/${params.aligner}/mergedLibrary/${params.allocation_method}/" },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
                enabled: params.save_allocation_intermeds
            ]
        }
    
    }
}

process {
    // See https://bioinformatics.stackexchange.com/a/4542
    withName: '.*:BAM_FILTER_SAMBAMBA_FINAL:SAMBAMBA_VIEW' {
        ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3" }
        ext.args = {
            [
                meta.single_end ? "-F 'mapping_quality >= 30 and not (unmapped or secondary_alignment) and not ([XA] != null or [SA] != null)'" :
                "-F 'paired and proper_pair and mapping_quality >= 30 and not (unmapped or mate_is_unmapped or secondary_alignment) and not ([XA] != null or [SA] != null)'",
                "--format bam"
            ].join(' ').trim()
        }
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/final_filter" 
            },
            mode: params.publish_dir_mode,
            pattern: '*.bam',
            saveAs: { (meta.single_end || params.save_align_intermeds) ? "${it}" : null }
        ]
    }

    withName: '.*:BAM_FILTER_SAMBAMBA_FINAL:BAM_SORT_STATS_SAMTOOLS:SAMTOOLS_SORT' {
        ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3.sorted" }
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/final_filter" 
            },
            mode: params.publish_dir_mode,
            pattern: '*.bam'
        ]
    }

    withName: '.*:BAM_FILTER_SAMBAMBA_FINAL:BAM_SORT_STATS_SAMTOOLS:SAMTOOLS_INDEX' {
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/final_filter" 
            },
            mode: params.publish_dir_mode,
            pattern: '*.{bai,csi,crai}'
        ]
    }

    withName: '.*:BAM_FILTER_SAMBAMBA_FINAL:BAM_SORT_STATS_SAMTOOLS:BAM_STATS_SAMTOOLS:.*' {
        ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3.sorted" }
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/final_filter" 
            },
            mode: params.publish_dir_mode,
            pattern: "*.{stats,flagstat,idxstats}"
        ]
    }
}

if (!params.skip_picard_metrics) {
    process {
        withName: 'PICARD_COLLECTMULTIPLEMETRICS' {
            ext.args   = '--VALIDATION_STRINGENCY LENIENT --TMP_DIR tmp'
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3" }
            publishDir = [
                [
                    path: { 
                        "${params.outdir}/${params.aligner}/mergedLibrary/" +
                        "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                        "/picard_metrics" 
                    },
                    mode: params.publish_dir_mode,
                    pattern: "*_metrics"
                ],
                [
                    path: { 
                        "${params.outdir}/${params.aligner}/mergedLibrary/" +
                        "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                        "/picard_metrics/pdf" 
                    },
                    mode: params.publish_dir_mode,
                    pattern: "*.pdf"
                ]
            ]
        }
    }
}

process {
    withName: '.*:BAM_SHIFT_READS:DEEPTOOLS_ALIGNMENTSIEVE' {
        ext.args   = '--ATACshift'
        ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3${meta.exp_type == 'atacseq' ? '.shifted' : ''}" }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}/alignmentsieve" },
            mode: params.publish_dir_mode,
            pattern: '*.bam',
            enabled: params.save_shifting_intermeds,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:BAM_SHIFT_READS:BAM_SORT_STATS_SAMTOOLS:SAMTOOLS_SORT' {
        ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3${meta.exp_type == 'atacseq' ? '.shifted' : ''}.sorted" }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}/alignmentsieve" },
            mode: params.publish_dir_mode,
            pattern: '*.bam',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:BAM_SHIFT_READS:BAM_SORT_STATS_SAMTOOLS:SAMTOOLS_INDEX' {
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}/alignmentsieve" },
            mode: params.publish_dir_mode,
            pattern: '*.{bai,csi,crai}',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:BAM_SHIFT_READS:BAM_SORT_STATS_SAMTOOLS:BAM_STATS_SAMTOOLS:SAMTOOLS_.*' {
        ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3${meta.exp_type == 'atacseq' ? '.shifted' : ''}.sorted" }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}/alignmentsieve" },
            mode: params.publish_dir_mode,
            pattern: "*.{stats,flagstat,idxstats}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}

if (!params.skip_spp) {
    process {
        withName: 'PHANTOMPEAKQUALTOOLS' {
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3${meta.exp_type == 'atacseq' ? '.shifted' : ''}" }
            ext.args   = { "--max-ppsize=500000" }
            ext.args2  = { "-p=$task.cpus -rf" }
            publishDir = [
                path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/phantompeakqualtools" 
                },
                mode: params.publish_dir_mode,
                pattern: "*.{out,pdf}"
            ]
        }

        withName: 'MULTIQC_CUSTOM_PHANTOMPEAKQUALTOOLS' {
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3${meta.exp_type == 'atacseq' ? '.shifted' : ''}" }
            publishDir = [
                path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/phantompeakqualtools" 
                },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }
    }
}

process {

    withName: '.*:BAM_BEDGRAPH_BIGWIG_BEDTOOLS_UCSC:BEDTOOLS_GENOMECOV' {
        ext.args   = { (meta.single_end && params.fragment_size > 0) ? "-fs ${params.fragment_size}" : '' }
        ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3" }
        publishDir = [
            [
                path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/genomecov" 
                },
                mode: params.publish_dir_mode,
                pattern: "*.bedGraph",
                enabled: false
            ],
            [
                path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/genomecov" 
                },
                mode: params.publish_dir_mode,
                pattern: "*.txt"
            ]
        ]
    }

    withName: '.*:BAM_BEDGRAPH_BIGWIG_BEDTOOLS_UCSC:UCSC_BEDGRAPHTOBIGWIG' {
        ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3${meta.exp_type == 'atacseq' ? '.shifted' : ''}" }
        publishDir = [
            path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/genomecov" 
                },
            mode: params.publish_dir_mode,
            pattern: "*.bigWig"
        ]
    }
}


if (!params.skip_plot_profile) {
    process {
        withName: 'DEEPTOOLS_COMPUTEMATRIX' {
            ext.args   = 'scale-regions --regionBodyLength 1000 --beforeRegionStartLength 3000 --afterRegionStartLength 3000 --missingDataAsZero --skipZeros --smartLabels'
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3${meta.exp_type == 'atacseq' ? '.shifted' : ''}" }
            publishDir = [
                path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/deepTools/plotProfile" 
                },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }

        withName: 'DEEPTOOLS_PLOTPROFILE' {
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3${meta.exp_type == 'atacseq' ? '.shifted' : ''}" }
            publishDir = [
                path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/deepTools/plotProfile" 
                },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }

        withName: 'DEEPTOOLS_PLOTHEATMAP' {
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3${meta.exp_type == 'atacseq' ? '.shifted' : ''}" }
            publishDir = [
                path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/deepTools/plotProfile" 
                },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }
    }
}

if (!params.skip_count_reads_in_bins) {
    process {
        withName: '.*:COUNT_READS_IN_BINS:BEDTOOLS_MAKEWINDOWS_1KB' {
            ext.prefix = { "${meta.id}.1kb_windows" }
            ext.args   = { [
                "-i srcwinnum",
                "-w 1000"
            ].join(' ').trim() }
            publishDir = [
                path: { "${params.outdir}/genome/windows" },
                mode: params.publish_dir_mode,
                pattern: "*.bed",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }

            ]
        }

        withName: '.*:COUNT_READS_IN_BINS:BEDTOOLS_MAKEWINDOWS_5KB' {
            ext.prefix = { "${meta.id}.5kb_windows" }
            ext.args   = { [
                "-i srcwinnum",
                "-w 5000"
            ].join(' ').trim() }
            publishDir = [
                path: { "${params.outdir}/genome/windows" },
                mode: params.publish_dir_mode,
                pattern: "*.bed",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }

            ]
        }

        withName: '.*:COUNT_READS_IN_BINS:BED_TO_SAF' {
            ext.prefix = { "${meta.id}.${meta.window_size}" }
            publishDir = [
                path: { "${params.outdir}/genome/windows" },
                mode: params.publish_dir_mode,
                pattern: "*.saf",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }

        withName: '.*:COUNT_READS_IN_BINS:SUBREAD_FEATURECOUNTS' {
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3${meta.exp_type == 'atacseq' ? '.shifted' : ''}${'.' + meta.window_size}" }
            ext.args   = { [
                meta.single_end ? "--countReadPairs" : "",
                "-B",
                "--ignoreDup",
                "-Q 30",
                '-F SAF',
                "-O"
            ].join(' ').trim() }
            publishDir = [
                path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/count_reads_in_bins/"
                },
                mode: params.publish_dir_mode,
                pattern: "*.{txt,txt.summary}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }
    }
}

process {
    withName: '.*:BAM_CHORSEQ_RRPM:CHOR_NORM_FACTOR_CALCULATION' {
        ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3.spikein_scale" }
        publishDir = [
            path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}/rrpm/"
                },
                mode: params.publish_dir_mode,
                pattern: "*.txt",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:BAM_CHORSEQ_RRPM:DEEPTOOLS_BAMCOVERAGE' {
        ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3.rrpm" }
        ext.args = { [
            params.chor_extend_reads ? "--extendReads ${params.chor_extend_reads}" : "",
            params.chor_bin_size ? "--binSize ${params.chor_bin_size}" : "",
            // TODO: the blacklist should be inputted to the process directly, which is not possible in the current nf-core implementation
            // params.blacklist ? "--blackListFileName ${params.blacklist}" : "",
            meta.rrpm_scale ? "--scaleFactor ${meta.rrpm_scale}" : "",
            "--outFileFormat bedgraph"
        ].join(' ').trim() }
        publishDir = [
            path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}/rrpm/"
                },
            mode: params.publish_dir_mode,
            pattern: "*.bedgraph",
            enabled: false,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:BAM_CHORSEQ_RRPM:FILE_SORT' {
        ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3.sorted.rrpm" }
        ext.args  = "-k1,1 -k2,2n"
        publishDir = [
              path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}/rrpm/"
                },
            mode: params.publish_dir_mode,
            pattern: "*.bedgraph",
            enabled: params.save_chor_intermeds
        ]
    }


    withName: '.*:BAM_CHORSEQ_RRPM:UCSC_BEDGRAPHTOBIGWIG' {
        ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3.rrpm" }
        publishDir = [
            path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}/rrpm/"
                },
            mode: params.publish_dir_mode,
            pattern: "*.bigWig",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}

if (params.bam_downsampling_method) {
    process {
        withName: '.*:BAM_DOWNSAMPLE:BAM_STATS_SAMTOOLS_INITIAL:.*' {
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3${meta.exp_type == 'atacseq' ? '.shifted' : ''}" }
            publishDir = [
                path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}/downsampled" 
                },
                mode: params.publish_dir_mode,
                pattern: "*.{stats,flagstat,idxstats}",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }

        withName: '.*:BAM_DOWNSAMPLE:BAM_FLAGSTAT_MAPPED' {
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3${meta.exp_type == 'atacseq' ? '.shifted' : ''}.total_reads" }
            publishDir = [
                path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}/downsampled" 
                },
                mode: params.publish_dir_mode,
                pattern: "*.txt",
                enabled: false,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }
        
        withName: '.*:BAM_DOWNSAMPLE:PICARD_DOWNSAMPLESAM' {
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3${meta.exp_type == 'atacseq' ? '.shifted' : ''}.dSp.sorted" }
            ext.args   = { [
                "--PROBABILITY ${meta.downsampleA_prob}",
                "--STRATEGY ${params.bam_downsampling_strategy}",
                "--ACCURACY ${params.bam_downsampling_accuracy}",
                "--VALIDATION_STRINGENCY LENIENT",
                "--TMP_DIR tmp"
            ].join(' ').trim() }
            publishDir = [
                path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}/downsampled" 
                },
                mode: params.publish_dir_mode,
                pattern: "*.bam",
                enabled: params.save_downsampling_intermeds,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }

        withName: '.*:BAM_DOWNSAMPLE:SAMTOOLS_INDEX' {
            publishDir = [
                path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}/downsampled" 
                },
                mode: params.publish_dir_mode,
                pattern: '*.{bai,csi,crai}',
                enabled: params.save_downsampling_intermeds,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }

        withName: '.*:BAM_DOWNSAMPLE:BAM_STATS_SAMTOOLS_FINAL:.*' {
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3${meta.exp_type == 'atacseq' ? '.shifted' : ''}.dSp.sorted" }
            publishDir = [
                path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}/downsampled" 
                },
                mode: params.publish_dir_mode,
                pattern: "*.{stats,flagstat,idxstats}",
                enabled: params.save_downsampling_intermeds,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }
    }
}

if (!params.skip_plot_fingerprint) {
    process {
        withName: 'DEEPTOOLS_PLOTFINGERPRINT' {
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3${meta.exp_type == 'atacseq' ? '.shifted' : ''}${params.bam_downsampling_method ? '.dSp' : '' }" }
            ext.args   = { [
                '--skipZeros',
                "--numberOfSamples $params.fingerprint_bins",
                "--labels $meta.id $meta.control"
            ].join(' ').trim() }
            publishDir = [
                path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/deepTools/plotFingerprint" 
                },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }
    }
}

process {
    withName: 'MACS3_CALLPEAK' {
        // TODO: this is only temporary to avoid not enough peaks error for samples with low read counts
        // try using workflow.failOnIgnore https://nextflow.io/docs/latest/reference/stdlib.html
        errorStrategy = { task.exitStatus == 1 ? 'ignore' : 'terminate' } 
        ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3${meta.exp_type == 'atacseq' ? '.shifted' : ''}${params.bam_downsampling_method ? '.dSp' : '' }" }
        ext.args   = {
            [
            '--keep-dup all',
            "--slocal ${params.macs_slocal}",
            meta.exp_type == 'atacseq'  ? "--nomodel --extsize ${params.macs_extsize}" : '',
            params.narrow_peak          ? '' : "--broad --broad-cutoff ${params.broad_cutoff}",
            params.save_macs_pileup     ? '--bdg --SPMR' : '',
            params.macs_fdr             ? "--qvalue ${params.macs_fdr}" : '',
            params.macs_pvalue          ? "--pvalue ${params.macs_pvalue}" : '',
            params.aligner == "chromap" ? "--format BAM" : ''
            ].join(' ').trim()
        }
        publishDir = [
            path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}/macs3/" +
                    "${params.narrow_peak ? 'narrow_peak' : 'broad_peak'}" 
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> 
                if (filename.equals('versions.yml')) {
                    return null
                } else {
                    // This replaces MACS3's suffixes of the form "*_control_lambda.bdg" with "*.control_lambda.bdg"
                    // TODO: instead of replacing this whole thing, we could use ext.prefix
                    def newFilename = filename.replaceFirst("^${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3${meta.exp_type == 'atacseq' ? '.shifted' : ''}${params.bam_downsampling_method ? '.dSp' : '' }_", "")
                    return "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3${meta.exp_type == 'atacseq' ? '.shifted' : ''}${params.bam_downsampling_method ? '.dSp' : '' }.${newFilename}"
                }
            }
        ]
    }

    if (params.save_macs_pileup) {
        withName: '.*:BAM_PEAKS_CALL_QC_ANNOTATE_MACS3_HOMER:MACS3_BDGCMP' {
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3${meta.exp_type == 'atacseq' ? '.shifted' : ''}${params.bam_downsampling_method ? '.dSp' : '' }.bdgcmp" }
            ext.args   = '--method FE'
            publishDir = [
                path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}/macs3/" +
                    "${params.narrow_peak ? 'narrow_peak' : 'broad_peak'}" +
                    "/bdgcmp"
                },
                mode: params.publish_dir_mode,
                pattern: "*.bedGraph",         
                enabled: params.save_macs_pileup_intermeds,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }

        withName: '.*:BAM_PEAKS_CALL_QC_ANNOTATE_MACS3_HOMER:BEDTOOLS_SLOP' {
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3${meta.exp_type == 'atacseq' ? '.shifted' : ''}${params.bam_downsampling_method ? '.dSp' : '' }.bdgcmp.slop" }
            ext.args   = "-b 0"
            publishDir = [
                path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}/macs3/" +
                    "${params.narrow_peak ? 'narrow_peak' : 'broad_peak'}" +
                    "/bdgcmp"
                },
                mode: params.publish_dir_mode,
                pattern: "*.bed",
                enabled: params.save_macs_pileup_intermeds
            ]
        }

        withName: '.*:BAM_PEAKS_CALL_QC_ANNOTATE_MACS3_HOMER:AWK_FIX_MACS3_BDGCMP' {
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3${meta.exp_type == 'atacseq' ? '.shifted' : ''}${params.bam_downsampling_method ? '.dSp' : '' }.bdgcmp.awk" }
            publishDir = [
                path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}/macs3/" +
                    "${params.narrow_peak ? 'narrow_peak' : 'broad_peak'}" +
                    "/bdgcmp"
                },
                mode: params.publish_dir_mode,
                pattern: "*.bed",
                enabled: params.save_macs_pileup_intermeds
            ]
        }

        withName: '.*:BAM_PEAKS_CALL_QC_ANNOTATE_MACS3_HOMER:UCSC_BEDCLIP' {
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3${meta.exp_type == 'atacseq' ? '.shifted' : ''}${params.bam_downsampling_method ? '.dSp' : '' }.bdgcmp.clip" }
            publishDir = [
                path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}/macs3/" +
                    "${params.narrow_peak ? 'narrow_peak' : 'broad_peak'}" +
                    "/bdgcmp"
                },
                mode: params.publish_dir_mode,
                pattern: "*.bedGraph",
                enabled: params.save_macs_pileup_intermeds
            ]
        }

        withName: '.*:BAM_PEAKS_CALL_QC_ANNOTATE_MACS3_HOMER:FILE_SORT' {
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3${meta.exp_type == 'atacseq' ? '.shifted' : ''}${params.bam_downsampling_method ? '.dSp' : '' }.bdgcmp" }
            ext.args  = "-k1,1 -k2,2n"
            publishDir = [
                path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}/macs3/" +
                    "${params.narrow_peak ? 'narrow_peak' : 'broad_peak'}" +
                    "/bdgcmp"
                },
                mode: params.publish_dir_mode,
                pattern: "*.sorted",
                enabled: params.save_macs_pileup_intermeds
            ]
        }

        withName: '.*:BAM_PEAKS_CALL_QC_ANNOTATE_MACS3_HOMER:UCSC_BEDGRAPHTOBIGWIG' {
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3${meta.exp_type == 'atacseq' ? '.shifted' : ''}${params.bam_downsampling_method ? '.dSp' : '' }.bdgcmp.fc.signal" }
            publishDir = [
                path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}/macs3/" +
                    "${params.narrow_peak ? 'narrow_peak' : 'broad_peak'}" +
                    "/bdgcmp"
                },
                mode: params.publish_dir_mode,
                pattern: "*.bigWig"
            ]
        }
    }

    withName: 'FRIP_SCORE' {
        ext.args   = '-bed -c -f 0.20'
        ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3${meta.exp_type == 'atacseq' ? '.shifted' : ''}${params.bam_downsampling_method ? '.dSp' : '' }.frip" }
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/${meta.exp_type}/macs3/" +
                "${params.narrow_peak ? 'narrow_peak' : 'broad_peak'}" +
                "/bdgcmp"
            },
            enabled: false
        ]
    }

    withName: 'MULTIQC_CUSTOM_PEAKS' {
        ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3${meta.exp_type == 'atacseq' ? '.shifted' : ''}${params.bam_downsampling_method ? '.dSp' : '' }.peaks" }
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/${meta.exp_type}/macs3/" +
                "${params.narrow_peak ? 'narrow_peak' : 'broad_peak'}" +
                "/qc"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}

if (!params.skip_peak_annotation) {
    process {
        withName: '.*:BAM_PEAKS_CALL_QC_ANNOTATE_MACS3_HOMER:HOMER_ANNOTATEPEAKS' {
            ext.args   = '-gid'
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3${meta.exp_type == 'atacseq' ? '.shifted' : ''}${params.bam_downsampling_method ? '.dSp' : '' }.peaks" }
            publishDir = [
                path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}/macs3/" +
                    "${params.narrow_peak ? 'narrow_peak' : 'broad_peak'}"
                },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }
    }

    if (!params.skip_peak_qc) {
        process {
            withName: 'PLOT_MACS3_QC' {
                ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3${meta.exp_type == 'atacseq' ? '.shifted' : ''}${params.bam_downsampling_method ? '.dSp' : '' }.macs3_peak_qc" }
                ext.args   = '-o ./'
                publishDir = [
                    path: { 
                        "${params.outdir}/${params.aligner}/mergedLibrary/" +
                        "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                        "/${meta.exp_type}/macs3/" +
                        "${params.narrow_peak ? 'narrow_peak' : 'broad_peak'}" +
                        "/qc"
                    },
                    mode: params.publish_dir_mode,
                    saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
                ]
            }

            withName: 'PLOT_HOMER_ANNOTATEPEAKS' {
                ext.args   = '-o ./'
                ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3${meta.exp_type == 'atacseq' ? '.shifted' : ''}${params.bam_downsampling_method ? '.dSp' : '' }.homer_annotatePeaks" }
                publishDir = [
                    path: { 
                        "${params.outdir}/${params.aligner}/mergedLibrary/" +
                        "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                        "/${meta.exp_type}/macs3/" +
                        "${params.narrow_peak ? 'narrow_peak' : 'broad_peak'}" +
                        "/qc"
                    },
                    mode: params.publish_dir_mode,
                    saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
                ]
            }
        }
    }
}

if (!params.skip_consensus_peaks) {
    process {
        withName: 'MACS3_CONSENSUS' {
            ext.when   = { meta.multiple_groups || meta.replicates_exist }
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3${meta.exp_type == 'atacseq' ? '.shifted' : ''}${params.bam_downsampling_method ? '.dSp' : '' }.consensus_peaks" }
            publishDir = [
                path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}/macs3/" +
                    "${params.narrow_peak ? 'narrow_peak' : 'broad_peak'}" +
                    "/consensus/${meta.id}"
                },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }

        withName: 'SUBREAD_FEATURECOUNTS'  {
            ext.args   = '-F SAF -O --fracOverlap 0.2'
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3${meta.exp_type == 'atacseq' ? '.shifted' : ''}${params.bam_downsampling_method ? '.dSp' : '' }.consensus_peaks" }
            publishDir = [
                path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}/macs3/" +
                    "${params.narrow_peak ? 'narrow_peak' : 'broad_peak'}" +
                    "/consensus/${meta.id}"
                },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }
    }

    if (!params.skip_peak_annotation) {
        process {
            withName: '.*:BED_CONSENSUS_QUANTIFY_QC_BEDTOOLS_FEATURECOUNTS_DESEQ2:HOMER_ANNOTATEPEAKS' {
                ext.args   = '-gid'
                ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3${meta.exp_type == 'atacseq' ? '.shifted' : ''}${params.bam_downsampling_method ? '.dSp' : '' }.consensus_peaks" }
                publishDir = [
                    path: { 
                        "${params.outdir}/${params.aligner}/mergedLibrary/" +
                        "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                        "/${meta.exp_type}/macs3/" +
                        "${params.narrow_peak ? 'narrow_peak' : 'broad_peak'}" +
                        "/consensus/${meta.id}"
                    },
                    mode: params.publish_dir_mode,
                    saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
                ]
            }

            withName: 'ANNOTATE_BOOLEAN_PEAKS' {
                ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3${meta.exp_type == 'atacseq' ? '.shifted' : ''}${params.bam_downsampling_method ? '.dSp' : '' }.consensus_peaks" }
                publishDir = [
                    path: { 
                        "${params.outdir}/${params.aligner}/mergedLibrary/" +
                        "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                        "/${meta.exp_type}/macs3/" +
                        "${params.narrow_peak ? 'narrow_peak' : 'broad_peak'}" +
                        "/consensus/${meta.id}"
                    },
                    mode: params.publish_dir_mode,
                    saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
                ]
            }
        }
    }

    if (!params.skip_deseq2_qc) {
        process {
            withName: 'DESEQ2_QC' {
                ext.when   = { meta.multiple_groups && meta.replicates_exist }
                ext.args   = [
                    '--id_col 1',
                    '--sample_suffix \'.mLb.clN.sorted.bam\'', // TODO: this is not correct, the following is:
                    '--count_col 7',
                    params.deseq2_vst ? '--vst TRUE' : ''
                ].join(' ').trim()
                ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3${meta.exp_type == 'atacseq' ? '.shifted' : ''}${params.bam_downsampling_method ? '.dSp' : '' }.consensus_peaks" }
                publishDir = [
                    path: { 
                        "${params.outdir}/${params.aligner}/mergedLibrary/" +
                        "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                        "/${meta.exp_type}/macs3/" +
                        "${params.narrow_peak ? 'narrow_peak' : 'broad_peak'}" +
                        "/consensus/${meta.id}/deseq2"
                    },
                    mode: params.publish_dir_mode,
                    saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
                ]
            }
        }
    }
}

process {
    withName: '.*:BAM_CREATE_SCAR_PARTITIONS:BAM_SPLIT_BY_STRAND' {
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/scarseq/split/bam"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            pattern: "*.bam",
            enabled: params.save_scarseq_intermeds
        ]
    }

    withName: '.*:BAM_CREATE_SCAR_PARTITIONS:BEDTOOLS_GENOMECOV' {
        ext.prefix = { meta.strand ? "${meta.id}.${meta.strand}" : "${meta.id}" }
        ext.args   = { [
            '-bg',
            meta.single_end && params.fragment_size > 0 ? "-fs ${params.fragment_size}" : '',
            !meta.single_end ? "-pc" : "",
            "-g $sizes"
        ].join(' ').trim() }
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/scarseq/split/bdg"
            },
            mode: params.publish_dir_mode,
            pattern: "*.bdg",
            enabled: params.save_scarseq_intermeds
        ]
    }

    withName: '.*:BAM_CREATE_SCAR_PARTITIONS:BEDTOOLS_SLOP' {
        ext.prefix = { meta.strand ? "${meta.id}.${meta.strand}.slop" : "${meta.id}.slop" }
        ext.args   = "-b ${params.scar_slop}"
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/scarseq/split/slop"
            },
            mode: params.publish_dir_mode,
            pattern: "*.bed",
            enabled: params.save_scarseq_intermeds
        ]
    }

    withName: '.*:BAM_CREATE_SCAR_PARTITIONS:UCSC_BEDCLIP' {
        ext.prefix = { meta.strand ? "${meta.id}.${meta.strand}.clip" : "${meta.id}.clip" }
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/scarseq/split/clip"
            },
            mode: params.publish_dir_mode,
            pattern: "*.bedGraph",
            enabled: params.save_scarseq_intermeds
        ]
    }

    withName: '.*:BAM_CREATE_SCAR_PARTITIONS:FILE_SORT_WINDOWS' {
        ext.prefix = { meta.strand ? "${meta.id}.${meta.strand}.clip" : "${meta.id}.clip" }
        ext.args  = "-k1,1 -k2,2n"
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/scarseq/split/sorted"
            },
            mode: params.publish_dir_mode,
            pattern: "*.sorted",
            enabled: params.save_scarseq_intermeds
        ]
    }

    withName: '.*:BAM_CREATE_SCAR_PARTITIONS:UCSC_BEDGRAPHTOBIGWIG_WINDOWS' {
        ext.prefix = { meta.strand ? "${meta.id}.${meta.strand}" : "${meta.id}" }
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/scarseq/split/bigwig"
            },
            mode: params.publish_dir_mode,
            pattern: "*.bigWig"
        ]
    }

    withName: '.*:BAM_CREATE_SCAR_PARTITIONS:BEDTOOLS_MAKEWINDOWS' {
        ext.args   = { [
            "-i srcwinnum",
            "-w ${params.scar_window_size}",
            "-s ${params.scar_step_size}"
        ].join(' ').trim() }
        ext.prefix = { "${meta.id}.windows" }
        publishDir = [
            path: { "${params.outdir}/genome/windows" },
            mode: params.publish_dir_mode,
            pattern: "*.bed",
            enabled: params.save_scarseq_intermeds
        ]
    }

    withName: '.*:BAM_CREATE_SCAR_PARTITIONS:BED_SPLIT_BY_CHROMOSOME' {
        ext.prefix = { "${meta.id}.chrsplit" }
        publishDir = [
            path: { "${params.outdir}/genome/windows" },
            mode: params.publish_dir_mode,
            pattern: "*.bed",
            enabled: params.save_scarseq_intermeds
        ]
    }

    withName: '.*:BAM_CREATE_SCAR_PARTITIONS:UCSC_BIGWIGAVERAGEOVERBED' {
        ext.prefix = { "${meta.id}.${meta.chr}.${meta.strand}.bwaob" }
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/scarseq/bwaob"
            },
            mode: params.publish_dir_mode,
            pattern: "*.tab",
            enabled: params.save_scarseq_intermeds
        ]
    }

    withName: '.*:BAM_CREATE_SCAR_PARTITIONS:CPM_CALCULATION_.*' {
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/scarseq/cpm"
            },
            mode: params.publish_dir_mode,
            pattern: "*.cpm",
            enabled: params.save_scarseq_intermeds
        ]
    }

    withName: '.*:BAM_CREATE_SCAR_PARTITIONS:NORMALIZE_STRANDS' {
        ext.prefix = { "${meta.id}.${meta.chr}.${meta.strand}" }
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/scarseq/norm"
            },
            mode: params.publish_dir_mode,
            pattern: "*.tab",
            enabled: params.save_scarseq_intermeds
        ]
    }

    withName: '.*:BAM_CREATE_SCAR_PARTITIONS:SUBSTRACT_INPUT' {
        ext.prefix = { "${meta.id}.${meta.chr}.${meta.strand}.norm" }
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/scarseq/minusinput"
            },
            mode: params.publish_dir_mode,
            pattern: "*.tab",
            enabled: params.save_scarseq_intermeds
        ]
    }

    withName: '.*:BAM_CREATE_SCAR_PARTITIONS:PARTITION_SMOOTH' {
        ext.prefix = { "${meta.id}.${meta.chr}${meta.minusinput ? '.minusinput' : ''}" }
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/scarseq/smooth"
            },
            mode: params.publish_dir_mode,
            pattern: "*.txt",
            enabled: params.save_scarseq_intermeds
        ]
    }

    withName: '.*:BAM_CREATE_SCAR_PARTITIONS:COLLECT_PARTITIONS_BY_CHROMOSOME' {
        ext.prefix = { "${meta.id}.${meta.chr}${meta.minusinput ? '.minusinput' : ''}.smooth_results.w${params.scar_window_size}.s${params.scar_radius}.d${params.scar_dradius}.z${params.scar_zradius}" }
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/scarseq/part_by_chr"
            },
            mode: params.publish_dir_mode,
            pattern: "*.txt",
            enabled: params.save_scarseq_intermeds
        ]
    }

    withName: '.*:BAM_CREATE_SCAR_PARTITIONS:FINAL_PARTITION_BEDGRAPH' {
        ext.prefix = { "${meta.id}${meta.minusinput ? '.minusinput' : ''}.smooth_results.w${params.scar_window_size}.s${params.scar_radius}.d${params.scar_dradius}.z${params.scar_zradius}" }
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/scarseq/final_smooth"
            },
            mode: params.publish_dir_mode,
            pattern: "*.{txt,tmp}",
            enabled: params.save_scarseq_intermeds
        ]
    }

    withName: '.*:BAM_CREATE_SCAR_PARTITIONS:FILE_SORT_PARTITIONS' {
        ext.prefix = { "${meta.id}${meta.minusinput ? '.minusinput' : ''}.smooth_results.w${params.scar_window_size}.s${params.scar_radius}.d${params.scar_dradius}.z${params.scar_zradius}" }
        ext.args  = "-k1,1 -k2,2n"
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/scarseq/final_smooth"
            },
            mode: params.publish_dir_mode,
            pattern: "*.bdg",
            enabled: params.save_scarseq_intermeds
        ]
    }

    withName: '.*:BAM_CREATE_SCAR_PARTITIONS:UCSC_BEDGRAPHTOBIGWIG_PARTITIONS' {
        ext.prefix = { "${meta.id}${meta.minusinput ? '.minusinput' : ''}.smooth_results.w${params.scar_window_size}.s${params.scar_radius}.d${params.scar_dradius}.z${params.scar_zradius}" }
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/scarseq/final_smooth"
            },
            mode: params.publish_dir_mode,
            pattern: "*.bigWig"
        ]
    }

    withName: '.*:BAM_CREATE_SCAR_PARTITIONS:FINAL_PARTITION_PLOT' {
        ext.prefix = { "${meta.id}.smooth_results.w${params.scar_window_size}.s${params.scar_radius}.d${params.scar_dradius}.z${params.scar_zradius}" }
        ext.args   = { [
            "--cpm_cutoff ${params.scar_cpm_cutoff}",
            "--plot_range ${params.scar_plot_range}",
            params.scar_exclude_chromosomes ? "--exclude_chromosomes '${params.scar_exclude_chromosomes}'" : ''
        ].join(' ').trim() }
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/scarseq/final_smooth/plots"
            },
            mode: params.publish_dir_mode,
            pattern: "*.pdf"
        ]
    }
}

process {
    withName: '.*:SAMTOOLS_STATS_SUMMARY:SAMTOOLS_STATS_TRANSPOSE' {
        publishDir = [ 
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/samtools_stats_summary/transposed"
            },
            mode: params.publish_dir_mode,
            pattern: "*.tsv",
            enabled: false
        ]
    }

    withName: '.*:SAMTOOLS_STATS_SUMMARY:SAMTOOLS_STATS_CAT' {
        ext.prefix = { "samtools_stats_summary${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3${meta.exp_type == 'atacseq' ? '.shifted' : ''}${params.bam_downsampling_method ? '.dSp' : '' }" }
        publishDir = [ 
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/samtools_stats_summary/"
            },
            mode: params.publish_dir_mode,
            pattern: "*.tsv"
        ]
    }

    withName: '.*:SAMTOOLS_STATS_SUMMARY:FINAL_STAT_SUMMARY' {
        ext.prefix = { "final_samtools_stats_summary${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3${meta.exp_type == 'atacseq' ? '.shifted' : ''}${params.bam_downsampling_method ? '.dSp' : '' }" }
        publishDir = [ 
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/samtools_stats_summary/"
            },
            mode: params.publish_dir_mode,
            pattern: "*.tsv"
        ]
    }
}

if (!params.skip_igv) {
    process {
        withName: 'IGV' {
            publishDir = [
                [
                    path: { 
                        "${params.outdir}/igv/" +
                        "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}/" +
                        "${params.narrow_peak ? 'narrow_peak' : 'broad_peak'}"
                    },
                    mode: params.publish_dir_mode,
                    pattern: '*.{txt,xml}'
                ],
                [
                    path: { "${params.outdir}/genome" },
                    mode: params.publish_dir_mode,
                    pattern: '*.{fa,fasta}'
                ]
            ]
        }
    }
}

if (!params.skip_multiqc) {
    process {
        withName: 'MULTIQC' {
            ext.args   = params.multiqc_title ? "--title \"$params.multiqc_title\"" : ''
            publishDir = [
                path: { 
                        "${params.outdir}/multiqc/" +
                        "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}/" +
                        "${params.narrow_peak ? 'narrow_peak' : 'broad_peak'}"
                    },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }
    }
}
