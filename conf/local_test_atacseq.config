/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run grothlab/glseq -profile ku_sund_danhead,local_test_atacseq --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {

    config_profile_contact      = 'Samuel Ruiz-Pérez <samuel.perez@cpr.ku.dk>'
    config_profile_name         = 'ATAC-seq test profile (for DAN System users)'
    config_profile_description  = 'Test dataset to check ATAC-seq analysis functions of the pipeline (for DAN System users)'

    // Input data
    input                       = params.local_testdata_base_path + 'samplesheets/local_test_atacseq_samplesheet.csv'
    read_length                 = 50

    // TODO: fix this (it is human without spike-ins)
    // Genome references
    aligner                     = 'chromap'
    chromap_index               = params.local_testdata_base_path + 'references/Homo_sapiens/T2T_CHM13/indices/chromap_0.2.6_index/chm13v2.0.index'
    fasta                       = params.local_testdata_base_path + 'references/Homo_sapiens/T2T_CHM13/genome/fasta/chm13v2.0.fa.gz'
    gff                         = params.local_testdata_base_path + 'references/Homo_sapiens/T2T_CHM13/annotations/transcript_models/gff/gencode.v47.annotation.liftOff.gff3'
    blacklist                   = params.local_testdata_base_path + 'references/Homo_sapiens/T2T_CHM13/annotations/blacklists/bed/chm13v2.liftover.ENCODE_ENCFF419RSJ.Kundaje.Excludable.bed.gz'
    genome                      = 'T2T_CHM13v2'

    // Other parameters
    skip_umi_extract            = false
    with_umi                    = true
    allocate_n_multimappers     = 20
    allocation_method           = 'allo'
    save_align_intermeds        = true

    // For speed to avoid CI time-out
    fingerprint_bins            = 200
    skip_plot_profile           = true

}