
process {
    withName: 'MINIMAP2_ALIGN' {
        ext.args   = {
            [
                params.minimap2_preset ? "-x ${params.minimap2_preset}" : '',
                params.minimap2_kmer_length ? "-k ${params.minimap2_kmer_length}" : '',
                params.minimap2_min_win_size ? "-w ${params.minimap2_min_win_size}" : '',
                params.map_n_multimappers ? "--secondary=yes -N ${params.map_n_multimappers}" : '',
                meta.read_group ? "-R @RG\\tID:${meta.id}\\tSM:${meta.id - ~/_T\\d+$/}\\tPL:ILLUMINA\\tLB:${meta.id}\\tPU:1" +
                    (params.seq_center ? "\\tCN:${params.seq_center}" : '') : ''
            ].join(' ').trim()
        }
        ext.prefix = { 
            "${meta.id}" +
            "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
            "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}" +
            ".Lb"
        }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/library" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            enabled: false
        ]
    }
}
